# Plantilla de producción. A diferencia de .env.example (pensado para
# `docker compose up` local), este archivo asume que la mayoría de estos
# valores NO viven aquí en texto plano, sino en un almacén de secretos
# gestionado (ver deploy/k8s/02-external-secrets.yaml) — este archivo
# documenta QUÉ va en cada variable y DE DÓNDE sale, para quien configure
# ese almacén por primera vez. No se commitea con valores reales.

# ---------------------------------------------------------------------------
# Generadas por nosotros mismos (bash scripts/generate_secrets.sh --backend
# aws-secrets-manager --secret-name erp-educativo/prod). NO requieren
# ninguna cuenta de terceros.
# ---------------------------------------------------------------------------
ERP_SECRET_KEY=
# Debe ser IDÉNTICO en core-erp-backend y multimedia-stream-server (ver
# multimedia-stream-server/state/auth.ts).
AI_AGENTS_INTERNAL_KEY=
# Debe ser IDÉNTICO en core-erp-backend y ai-agents-engine (ver
# ai-agents-engine/config/erp_client.py y core-erp-backend/api/grades.py).

# ---------------------------------------------------------------------------
# Infraestructura gestionada — reemplazar por los endpoints reales de tu
# proveedor (ver deploy/k8s/README.md, sección "Qué NO resuelve esto").
# ---------------------------------------------------------------------------
ERP_DATABASE_URL=postgresql+psycopg2://USUARIO:PASSWORD@TU-INSTANCIA-RDS.rds.amazonaws.com:5432/erp_educativo
# Opcional: réplica de lectura (ver core-erp-backend/scripts/setup_read_replica.sh)
ERP_DATABASE_URL_REPLICA=
ERP_REDIS_URL=redis://TU-CLUSTER-ELASTICACHE.cache.amazonaws.com:6379/0

CORS_ALLOWED_ORIGINS=https://app.tu-dominio.edu.pe

ERP_RATE_LIMIT_PER_ORG_PER_MIN=300
ERP_RATE_LIMIT_PER_IP_PER_MIN=60
ERP_RATE_LIMIT_AUTH_PER_IP_PER_MIN=10
ERP_RATE_LIMIT_WINDOW_SECONDS=60

CRDT_PORT=4444
CRDT_STORAGE_DIR=/app/storage

# ---------------------------------------------------------------------------
# Cuentas de terceros reales — cada una requiere que la institución (no
# este script) cree y verifique la cuenta correspondiente.
# ---------------------------------------------------------------------------

# ai-agents-engine: sin esto, corre en modo mock (ya probado end-to-end
# con evals/run_evals.py). Cuenta propia en https://console.anthropic.com
ANTHROPIC_API_KEY=
# Proveedor de respaldo opcional (ver ai-agents-engine/config/llm_client.py)
OPENAI_API_KEY=
ANTHROPIC_FALLBACK_API_KEY=

# Pasarela de pago (api/billing.py). PAYMENT_GATEWAY_PROVIDER=stripe es
# el único proveedor con integración real implementada en este momento
# (ver api/billing.py) — Stripe NO soporta PEN como moneda de cobro, así
# que si las pensiones se cobran en soles, este backend rechaza el pago
# explícitamente y hay que integrar Culqi/Niubiz/MercadoPago (documentado
# pero no implementado aún) o facturar en una moneda que Stripe sí soporte.
PAYMENT_GATEWAY_PROVIDER=stripe
PAYMENT_GATEWAY_API_KEY=
# Cuenta real (verificada, con datos bancarios) en https://dashboard.stripe.com

# LiveKit (WebRTC/streaming del profesor) — ver
# multimedia-stream-server/streaming/webrtc_handler.ts para el contrato
# de integración pendiente. Cuenta en https://cloud.livekit.io o
# self-host con su Helm chart oficial.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

# Biometría KYC (compliance-service B2B, si se retoma) — https://faceio.net
FACEIO_APP_ID=
FACEIO_APP_SECRET=

# ---------------------------------------------------------------------------
# Observabilidad (opcional en producción, recomendado)
# ---------------------------------------------------------------------------
# Endpoint OTLP de tu backend de trazas (Grafana Tempo, Honeycomb, etc.)
# Sin esto, setup_tracing() sigue instrumentando pero no exporta a nada
# fuera del proceso.
OTEL_EXPORTER_OTLP_ENDPOINT=
