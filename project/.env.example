# Backend ERP
ERP_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/erp_educativo
ERP_REDIS_URL=redis://localhost:6379/0
# Genera el tuyo con: bash scripts/generate_secrets.sh
ERP_SECRET_KEY=change-me-in-production
# En producción: el dominio real del frontend, nunca "*" con credenciales.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (nuevo) — protege de un tenant saturando a los demás y de
# fuerza bruta contra /auth/login. Fail-open si Redis no responde (ver
# observability/rate_limiter.py). Valores por defecto ya son los que se
# usan si no defines estas variables.
ERP_RATE_LIMIT_PER_ORG_PER_MIN=300
ERP_RATE_LIMIT_PER_IP_PER_MIN=60
ERP_RATE_LIMIT_AUTH_PER_IP_PER_MIN=10
ERP_RATE_LIMIT_WINDOW_SECONDS=60

# Solo para correr los tests (base separada, se recrea en cada corrida)
# ERP_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/erp_educativo_test
# ERP_REDIS_URL=redis://localhost:6379/1

# ai-agents-engine — si defines esta variable, el pipeline usa la API real
# de Claude en vez del modo mock. Sin ella, corre en modo mock (probado).
# Consíguela en https://console.anthropic.com (cuenta propia, no puedo
# generarla yo — es una credencial ligada a tu cuenta y forma de pago).
ANTHROPIC_API_KEY=

# Secreto compartido entre ai-agents-engine y core-erp-backend (nuevo):
# autentica POST /grades/submit-from-agent, el endpoint que usa
# grading_agent para que sus calificaciones lleguen al ERP real (ver
# ai-agents-engine/config/erp_client.py y core-erp-backend/api/grades.py).
# Genera el tuyo con: bash scripts/generate_secrets.sh
# DEBE ser idéntico en ambos servicios. Sin definir, ese endpoint queda
# deshabilitado (fail-closed) y el agente sigue calificando normalmente,
# solo que la nota no se sincroniza con el ERP.
AI_AGENTS_INTERNAL_KEY=change-me-in-production
# core-erp-backend necesita saber su propia URL para nada (es el
# servidor); ai-agents-engine sí necesita saber DÓNDE está el ERP:
ERP_API_BASE_URL=http://localhost:8200

# multimedia-stream-server — DEBE ser idéntico a ERP_SECRET_KEY de arriba
ERP_SECRET_KEY=change-me-in-production
# Debe apuntar al MISMO Redis que usa el ERP — se consulta para saber si
# un token fue revocado (logout). Sin esto, el servidor rechaza TODAS las
# conexiones por diseño (fail-closed).
ERP_REDIS_URL=redis://localhost:6379/0
CRDT_PORT=4444
CRDT_STORAGE_DIR=./storage

# --- Pasarela de pago (api/billing.py) ---
# Sin esta variable, /billing corre en modo mock (probado end-to-end con
# pytest). Con PAYMENT_GATEWAY_API_KEY definida, PAYMENT_GATEWAY_PROVIDER
# decide el proveedor real:
#   stripe (por defecto, YA implementado — ver api/billing.py y
#     tests/test_billing_stripe.py): https://dashboard.stripe.com
#     OJO: Stripe no soporta PEN. Para pensiones en soles usa Culqi o
#     Niubiz (documentados abajo, sin implementación real aún — requieren
#     RUC de la institución educativa).
#   Culqi:     https://culqi.com (dashboard > llaves API)
#   Niubiz:    https://desarrolladores.niubiz.com.pe
#   MercadoPago: https://www.mercadopago.com.pe/developers
# No puedo generar esta key: es una credencial de una cuenta de comercio
# real verificada, no un secreto que se pueda derivar matemáticamente
# como ERP_SECRET_KEY.
PAYMENT_GATEWAY_PROVIDER=stripe
PAYMENT_GATEWAY_API_KEY=

# --- Biometría KYC (si se retoma el compliance-service del negocio B2B) ---
# FaceIO también requiere cuenta propia: https://faceio.net (Application ID + secreto)
# No configurado en este ERP educativo — quedó documentado por si se
# retoma la idea de negocio de compliance-as-a-service vista antes.
FACEIO_APP_ID=
FACEIO_APP_SECRET=

# Producción futura (no usado todavía, documentado para cuando aplique)
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
